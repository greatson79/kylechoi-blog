---
// §서비스/제공 — 교육(WAVE Academy) + 컨설팅. About 페이지 블록.
// ★커리 수치 SOT = Ai_works/output/WaveAI/Edu본부/_round/트랙구성_주인님보고_v1.3_2026-08-05.md
// 상세는 /curriculum 페이지가 정본 표시면 — 여기는 진입 동선만 둔다(가격·정원 미기재).
const services = [
  {
    label: '교육',
    brand: 'WAVE Academy',
    items: [
      { t: '목회자 AI 교육', d: '사역 현장에 맞춘 실전 AI 활용 교육.' },
      { t: 'AI 리터러시 교육', d: 'AI를 분별 있게 이해하고 다루는 기본기.' },
    ],
    cta: {
      label: '개인 과정 보기',
      href: '/curriculum/#personal',
      d: '두 갈래가 각각 2단으로 이어집니다. 단마다 8h · 2시간 × 4회차 · 4주.',
    },
  },
  {
    label: '컨설팅',
    brand: '',
    items: [
      { t: 'AI 목회 자동화 컨설팅', d: '콘텐츠·행정·사역 흐름의 AI 자동화 설계.' },
      { t: '교육 컨설팅', d: '교육 과정·콘텐츠·도구 도입 설계.' },
    ],
    cta: {
      label: '컨설팅 과정 보기',
      href: '/curriculum/#organization',
      d: 'Solo 12h에서 Ensemble 30h로 이어집니다. 일정은 조율 가능합니다.',
    },
  },
];
---
<section class="services section">
  <div class="container">
    <span class="eyebrow">제공 서비스</span>
    <h2>교육과 컨설팅</h2>
    <div class="svc-grid">
      {services.map((s) => (
        <div class="svc-group">
          <div class="svc-head">
            <span class="svc-label">{s.label}</span>
            {s.brand && <span class="svc-brand">{s.brand}</span>}
          </div>
          <ul>
            {s.items.map((it) => (
              <li>
                <strong>{it.t}</strong>
                <span>{it.d}</span>
              </li>
            ))}
          </ul>
          {s.cta && (
            <div class="svc-cta">
              <p class="svc-cta__d">{s.cta.d}</p>
              <a class="svc-cta__link" href={s.cta.href}>{s.cta.label} <span aria-hidden="true">→</span></a>
            </div>
          )}
        </div>
      ))}
    </div>

    <div class="svc-curriculum">
      <p class="svc-curriculum__label">커리큘럼</p>
      <p class="svc-curriculum__lede">
        교육과 컨설팅은 <strong>정해진 과정</strong>으로 운영합니다. 조직은 한 사람이 AI를 쓰는
        단계(Solo · 12h)에서 여러 역할이 함께 도는 체제를 세우는 단계(Ensemble · 30h)로 이어지고,
        개인은 두 갈래가 각각 2단으로 이어집니다(단마다 8h · 2시간 × 4회차 · 4주).
      </p>
      <p class="svc-curriculum__sub">
        구성과 시수, 그리고 왜 그렇게 설계했는지를 커리큘럼 페이지에 정리해 두었습니다.
      </p>
      <a class="svc-curriculum__link" href="/curriculum/">커리큘럼 보기 <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

<style>
  .services h2 { margin-top: 0.3em; }
  .svc-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--gap-grid); margin-top: var(--space-block); }
  .svc-group { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; }
  .svc-head { display: flex; align-items: baseline; gap: 0.6rem; margin-bottom: 1rem; }
  .svc-label { font-size: 1.2rem; font-weight: 700; color: var(--ink); }
  .svc-brand { font-size: 0.82rem; font-weight: 600; color: var(--accent-ink); letter-spacing: 0.02em; }
  .svc-group ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .svc-group li { display: flex; flex-direction: column; gap: 0.25rem; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .svc-group li:last-child { border-bottom: 0; padding-bottom: 0; }
  .svc-group strong { font-size: 1.02rem; color: var(--ink); }
  .svc-group span { font-size: 0.9rem; color: var(--muted); line-height: 1.5; }

  .svc-cta { margin-top: 1.1rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
  .svc-cta__d { font-size: 0.88rem; color: var(--muted); line-height: 1.55; }
  .svc-cta__link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin-top: 0.5rem; min-height: 44px;
    font-size: 0.95rem; font-weight: 700;
    color: var(--accent-ink); border-bottom: 1px solid currentColor;
  }

  .svc-curriculum { margin-top: var(--space-block); padding-top: var(--space-block); border-top: 1px solid var(--line); }
  .svc-curriculum__label {
    font-size: var(--text-small); font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent-ink);
  }
  .svc-curriculum__lede {
    max-width: var(--measure); margin-top: 0.6rem;
    color: var(--ink); line-height: var(--leading-body);
  }
  .svc-curriculum__lede strong { font-weight: 700; }
  .svc-curriculum__sub { max-width: var(--measure); margin-top: 0.5rem; color: var(--muted); line-height: 1.6; }
  .svc-curriculum__link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    margin-top: 0.9rem; min-height: 44px;
    font-weight: 700; color: var(--accent-ink); border-bottom: 1px solid currentColor;
  }
</style>
