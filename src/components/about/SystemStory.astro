---
// §A 회사 소개 — AI 멀티에이전트 시스템 + 운영 브랜드(정본 반영).
const steps = [
  { k: 'CEO', d: '전략·라우팅·승인' },
  { k: '부서', d: '교육·콘텐츠·분석 생산' },
  { k: '검증', d: '사실·품질 적대 검증' },
  { k: '발행', d: '사람 승인 후 공개' },
];
const brands = [
  { name: 'WAVE AI Networks', desc: '디딤교회 AI project — 콘텐츠·사역을 위한 AI 시스템.' },
  { name: 'WAVE Academy', desc: 'AI 교육 — 목회자 AI 교육 · AI 리터러시 교육.', href: '/ministry/' },
];
---
<section class="system-story section">
  <div class="container">
    <span class="eyebrow">회사 소개</span>
    <h2>AI가 하나의 조직처럼<br />협업해 콘텐츠를 만듭니다</h2>
    <p class="lead">
      DiA Ai Edu. Solution은 <strong>AI 에이전트들이 사람처럼 협업하는 콘텐츠·교육 회사</strong>입니다.
      CEO와 각 부서, 그리고 품질을 검증하는 적대적 리뷰어 — 여러 AI가 하나의 회사 조직처럼 일하며,
      <strong>목회 · 교육 · 시대분석 · AI 트렌드</strong> 콘텐츠를 만듭니다. 단순히 'AI가 쓴 글'이 아니라,
      기획하고 만들고 <strong>검증하고 다듬는</strong> 협업 과정을 거친 콘텐츠를 지향합니다.
    </p>
    <ol class="flow">
      {steps.map((s, i) => (
        <li class="flow-step">
          <span class="flow-num">{i + 1}</span>
          <strong>{s.k}</strong>
          <span class="flow-desc">{s.d}</span>
        </li>
      ))}
    </ol>

    <div class="brands">
      <h3>운영 브랜드</h3>
      <div class="brand-cards">
        {brands.map((b) => {
          const Tag = b.href ? 'a' : 'div';
          return (
            <Tag class="brand-card" href={b.href}>
              <strong>{b.name}{b.href && <span class="arr"> →</span>}</strong>
              <span>{b.desc}</span>
            </Tag>
          );
        })}
      </div>
    </div>
  </div>
</section>

<style>
  .system-story { background: var(--surface); }
  .system-story h2 { margin-top: 0.3em; }
  .lead { max-width: var(--measure); margin-top: 1.1rem; color: var(--muted); font-size: 1.15rem; line-height: 1.7; }
  .lead strong { color: var(--ink); font-weight: 600; }
  .flow { list-style: none; padding: 0; margin: var(--space-block) 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr)); gap: var(--gap-grid); }
  .flow-step { background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.3rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .flow-num { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: var(--accent); color: #fff; font-weight: 700; font-size: 0.9rem; }
  .flow-step strong { font-size: 1.1rem; margin-top: 0.3rem; }
  .flow-desc { font-size: 0.9rem; color: var(--muted); }

  .brands { margin-top: var(--space-block); }
  .brands h3 { font-size: var(--text-h3); margin-bottom: 1rem; }
  .brand-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: var(--gap-grid); }
  .brand-card { display: flex; flex-direction: column; gap: 0.4rem; padding: 1.3rem 1.4rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease); }
  a.brand-card:hover { transform: translateY(-3px); border-color: var(--accent); }
  .brand-card strong { font-size: 1.15rem; color: var(--ink); }
  .brand-card .arr { color: var(--accent-ink); }
  .brand-card span { font-size: 0.92rem; color: var(--muted); line-height: 1.55; }
</style>
