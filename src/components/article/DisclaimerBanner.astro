---
// ★투자자문법 면책 배너 — insight 채널에서 disclaimerRequired=true일 때만 노출(조건부).
interface Props { required?: boolean; }
const { required = false } = Astro.props;
---
{required && (
  <aside class="disclaimer-banner" role="note" aria-label="투자 관련 면책">
    <strong>투자 자문 아님 · 정보 제공 목적</strong>
    <p>본 콘텐츠는 시장·투자 관련 정보를 정보 제공 목적으로 다루며, 특정 종목·상품의 매매 권유나 투자 자문이 아닙니다.
      투자 판단과 그 결과의 책임은 투자자 본인에게 있습니다. (작성 시점 기준 정보)</p>
  </aside>
)}

<style>
  .disclaimer-banner {
    margin: 0 auto var(--space-block); max-width: var(--measure);
    background: var(--surface); border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: var(--radius-sm);
    padding: 0.9rem 1.1rem;
  }
  .disclaimer-banner strong { display: block; font-size: 0.9rem; color: var(--accent-ink); margin-bottom: 0.3rem; }
  .disclaimer-banner p { font-size: 0.84rem; color: var(--muted); line-height: 1.55; margin: 0; }
</style>
