---
// 교육(AI 교육) 목록 — ministry 컬렉션 中 category=교육만 필터.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/nav/Header.astro';
import Footer from '../../components/nav/Footer.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('ministry', ({ data }) => !data.draft && data.category === '교육'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="교육 — DiA" description="AI 교육 — 목회자 AI 교육·AI 리터러시 교육." channel="ministry">
  <Header slot="header" />
  <section class="section">
    <div class="container">
      <p class="eyebrow">교육</p>
      <h1>교육</h1>
      <p class="sub">AI 교육 — AI를 분별 있게 배우고 활용하기.</p>
      {posts.length ? (
        <div class="card-grid" style="margin-top: var(--space-block)">
          {posts.map((p) => (
            <ArticleCard href={`/education/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">아직 발행된 글이 없습니다.</p>}
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .sub { color: var(--muted); margin-top: 0.5rem; font-size: var(--text-h3); }
  .empty { color: var(--faint); margin-top: var(--space-block); }
</style>
