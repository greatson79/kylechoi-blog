  kicker: string;
  title: string;
  hours: string;
  schedule?: string;
  lede: string;
  items: string[];
  note?: string;
  optional?: boolean;
  /** 개인 과정 진입 조건 — SOT §5 "단독 성립" 열 직인용 */
  entry?: string;
  /** 과정 구조 다이어그램(장식) — public/images/curriculum/ */
  image: string;
};

