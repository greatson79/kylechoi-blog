---
// 시대분석 상세 — insight 中 ★category='시대분석'만(공개·강면책 InsightLayout). AI트렌드는 /ai-trend로 분리.
import { getCollection, render } from 'astro:content';
import InsightLayout from '../../layouts/InsightLayout.astro';

export async function getStaticPaths() {
  // ★agy HOLD#1 반영: factChecked(사람 검증·승인)된 글만 상세 빌드 — 미검증 노출 차단.
  const posts = await getCollection('insight', ({ data }) => !data.draft && data.category === '시대분석' && data.factChecked);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
---
<InsightLayout
  title={d.title}
  description={d.description}
  category={d.category}
  pubDate={d.pubDate}
  author={d.author}
  heroImage={d.heroImage}
  disclaimerRequired={d.disclaimerRequired}
>
  <Content />
</InsightLayout>
