---
// 시대분석 목록 — insight 中 category='시대분석' ★공개(주인님 2026-06-25 지시: 격리→공개).
// 강면책(투자자문법) 상시 노출. AI트렌드는 /ai-trend로 분리.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/nav/Header.astro';
import Footer from '../../components/nav/Footer.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { getCollection } from 'astro:content';

// ★agy HOLD#1 반영: factChecked(사람 검증·승인)된 글만 공개 — 미검증 노출 차단.
const posts = (await getCollection('insight', ({ data }) => !data.draft && data.category === '시대분석' && data.factChecked))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="시대분석 — DiA" description="거시·사회·기술 등 시대 흐름을 정보 제공 목적으로 정리한 시대분석. 투자 자문 아님." channel="insight">
  <Header slot="header" />
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">시대분석</p>
      <h1>시대를 읽는 분석</h1>
      <p class="lede">거시·사회·기술 등 <strong>시대 흐름을 정보 제공 목적</strong>으로 정리합니다. 출처·근거 기반의 분별.</p>

      <!-- ★면책(정보제공·비투자자문) — 상시 -->
      <aside class="disclaimer" role="note" aria-label="정보 제공 목적 안내">
        <strong>정보 제공 목적 · 투자 자문 아님</strong>
        <p>시대분석은 거시·사회·기술 등 <b>시대 흐름을 정보 제공 목적</b>으로 정리합니다. 특정 종목·상품의
          매매 신호나 투자 자문·권유가 아니며, 작성 시점 기준 정보입니다.
          본 콘텐츠는 자본시장법상 투자자문업·유사투자자문업에 해당하지 않습니다.</p>
      </aside>
    </div>

    <div class="container">
      {posts.length ? (
        <div class="card-grid" style="margin-top: var(--space-block)">
          {posts.map((p) => (
            <ArticleCard href={`/insight/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .narrow { max-width: 60ch; }
  .lede { margin-top: 1rem; font-size: var(--text-h3); color: var(--muted); line-height: 1.55; }
  .disclaimer { margin: var(--space-block) 0 0; background: var(--surface); border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: var(--radius-sm); padding: 1rem 1.2rem; }
  .disclaimer strong { display: block; font-size: 0.92rem; color: var(--accent-ink); margin-bottom: 0.4rem; }
  .disclaimer p { font-size: 0.84rem; color: var(--muted); line-height: 1.6; margin: 0; }
  .empty { color: var(--faint); margin-top: var(--space-block); }
</style>
