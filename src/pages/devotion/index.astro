---
// 묵상 목록 — 발행하는 묵상(ministry 컬렉션 中 category=묵상).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/nav/Header.astro';
import Footer from '../../components/nav/Footer.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('ministry', ({ data }) => !data.draft && data.category === '묵상'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="묵상 — DiA Ministry" description="발행하는 매일 묵상." channel="ministry">
  <Header slot="header" />
  <section class="section">
    <div class="container">
      <p class="eyebrow">Ministry · 묵상</p>
      <h1>묵상</h1>
      <p class="sub">짧게 읽고 하루를 시작하는 발행 묵상.</p>
      {posts.length ? (
        <div class="card-grid" style="margin-top: var(--space-block)">
          {posts.map((p) => (
            <ArticleCard href={`/devotion/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">아직 발행된 묵상이 없습니다.</p>}
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .sub { color: var(--muted); margin-top: 0.5rem; font-size: var(--text-h3); }
  .empty { color: var(--faint); margin-top: var(--space-block); }
</style>
