---
// /about — 회사·대표 소개. Hero + SystemStory + FounderProfile. ★텍스트 placeholder(CEO 초안).
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import SystemStory from '../components/about/SystemStory.astro';
import Services from '../components/about/Services.astro';
import FounderProfile from '../components/about/FounderProfile.astro';
---
<BaseLayout title="소개 — Kyle Choi Notes" description="저는 AI를 일과 삶에 실제로 적용하는 법을 만들고 나눕니다. 두려움도 맹신도 없이, 분별 있게.">
  <Header slot="header" />

  <section class="about-hero section">
    <div class="container">
      <p class="eyebrow">About · Kyle Choi</p>
      <h1>AI를 일과 삶에<br />적용하는 법을 만듭니다</h1>
      <p class="hero-lede">저는 목회와 교육 현장에서 사람을 세우는 일을 해왔고, 지금은 AI를 일과 삶에 실제로 적용하는 법을 만들고 나눕니다. 두려움도 맹신도 없이, 분별 있게.</p>
    </div>
  </section>

  <SystemStory />
  <Services />
  <FounderProfile />

  <Footer slot="footer" />
</BaseLayout>

<style>
  .about-hero { padding-block: var(--space-section); }
  .about-hero h1 { margin-top: 0.2em; }
  .hero-lede { max-width: 48ch; margin-top: 1.2rem; font-size: var(--text-h3); color: var(--muted); line-height: 1.5; }
</style>
