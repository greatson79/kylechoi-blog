---
/**
 * /learn — 외부 AI 학습자료를 목적별로 모은 안내 페이지.
 * 링크·제목 정본: src/data/learning-resources.mjs
 */
import Footer from '../components/nav/Footer.astro';
import Header from '../components/nav/Header.astro';
import { learningResources } from '../data/learning-resources.mjs';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="AI 학습자료실 — Kyle Choi Notes"
  description="프롬프트부터 AI 업무 흐름까지, 목적에 맞는 실전 학습자료를 한곳에서 찾아보세요."
>
  <Header slot="header" />

  <section class="learning-hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Learning Room</p>
        <h1>AI 학습자료실</h1>
        <p class="hero-lede">
          도구를 넓게 훑는 대신, 지금 필요한 주제부터 분명하게 시작할 수 있도록
          실전 학습자료를 한곳에 모았습니다.
        </p>
      </div>
      <aside class="hero-note" aria-label="학습자료실 이용 안내">
        <p class="note-label">이용 안내</p>
        <p>다섯 자료는 원본 학습 페이지로 연결되며, 선택한 자료는 새 탭에서 열립니다.</p>
      </aside>
    </div>
  </section>

  <section class="section resource-section" aria-labelledby="resource-heading">
    <div class="container">
      <header class="section-head">
        <p class="eyebrow">Start Here</p>
        <h2 id="resource-heading">지금 시작할 수 있는 자료</h2>
        <p>관심 있는 주제를 고르면 해당 학습 페이지로 바로 이동합니다.</p>
      </header>

      <ol class="resource-grid">
        {learningResources.map((resource, index) => (
          <li>
            <a
              class="resource-card"
              href={resource.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${resource.title} — 새 탭에서 열기`}
            >
              <div class="card-topline">
                <span class="card-number">{String(index + 1).padStart(2, '0')}</span>
                <span class="card-category">{resource.category}</span>
              </div>
              <div class="card-copy">
                <h3>{resource.title}</h3>
                <p>{resource.description}</p>
              </div>
              <div class="card-footer">
                <span>jinminlee.com</span>
                <span class="card-action" aria-hidden="true">자료 열기&nbsp;↗</span>
              </div>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .learning-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 11vw, 9rem);
    background:
      radial-gradient(circle at 82% 18%, oklch(86% 0.08 230 / 0.65), transparent 32%),
      linear-gradient(145deg, var(--surface), var(--bg) 68%);
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: end;
  }

  .hero-copy { max-width: 760px; }

  .eyebrow {
    color: var(--accent-ink);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1 {
    margin-top: 0.9rem;
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .hero-lede {
    max-width: 42ch;
    margin-top: clamp(1.5rem, 3vw, 2.2rem);
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    line-height: 1.75;
  }

  .hero-note {
    max-width: 360px;
    padding: 1.35rem 1.4rem;
    background: oklch(100% 0 0 / 0.72);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 18px 50px oklch(30% 0.03 235 / 0.08);
  }

  .note-label {
    margin-bottom: 0.55rem;
    color: var(--accent-ink);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .hero-note p:last-child {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.65;
  }

  .resource-section { padding-bottom: 0; }

  .section-head { max-width: 680px; }

  .section-head h2 {
    margin-top: 0.65rem;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .section-head > p:last-child {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .resource-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-grid);
    margin-top: clamp(2.4rem, 5vw, 4rem);
    padding: 0;
    list-style: none;
  }

  .resource-grid > li { display: flex; }

  .resource-card {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 330px;
    padding: clamp(1.4rem, 3vw, 2rem);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 10px 34px oklch(30% 0.02 235 / 0.05);
    transition:
      transform var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }

  .resource-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 18px 42px oklch(30% 0.04 235 / 0.1);
  }

  .resource-card:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .card-topline,
  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .card-number {
    color: var(--muted);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .card-category {
    padding: 0.3rem 0.7rem;
    color: var(--accent-ink);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .card-copy { margin-block: auto; padding-block: 2.2rem; }

  .card-copy h3 {
    max-width: 18ch;
    font-size: clamp(1.45rem, 3vw, 2rem);
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .card-copy p {
    margin-top: 1rem;
    color: var(--muted);
    line-height: 1.7;
  }

  .card-footer {
    padding-top: 1.15rem;
    color: var(--muted);
    font-size: 0.78rem;
    border-top: 1px solid var(--line);
  }

  .card-action { color: var(--accent-ink); font-weight: 800; }

  @media (min-width: 768px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(240px, 0.42fr); }
    .resource-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 480px) {
    .learning-hero { padding-block: 4.5rem; }
    .resource-card { min-height: 300px; }
    .card-footer { align-items: flex-end; }
  }
</style>
