---
// /contact — 강연·교육 문의 페이지
// 폼 백엔드: Web3Forms (access_key = 환경변수 주입, 시크릿 미커밋)
// 제출 도착지 이메일은 Web3Forms 대시보드에서 access_key 발급 시 지정한다(폼 코드에 넣지 않음).
// ★프로비저닝(주인님 계정 액션): web3forms.com에서 greatson79@gmail.com으로 access_key 발급 →
//   .env(로컬)·Vercel 환경변수에 PUBLIC_WEB3FORMS_ACCESS_KEY=<발급키> 설정. 미설정 시 폼은 안내 문구 표시.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const email = 'greatson79@gmail.com';
const phone = '010-3094-8899';
const inquiryTypes = ['강연 섭외', 'AI 교육 컨설팅', '워크숍 · 세미나', '기타 문의'];
---
<BaseLayout title="강연·교육 문의 — Kyle Choi Notes" description="교회·기업·교육기관 대상 AI 강연, 교육 컨설팅, 워크숍 문의를 남겨 주시면 확인 후 답변 드립니다.">
  <Header slot="header" />

  <section class="contact-section section">
    <div class="container contact-grid">
      <div class="contact-info">
        <p class="eyebrow">Contact</p>
        <h1>강연·교육을<br />의뢰하시려면</h1>
        <p class="lede">AI와 신앙, 교육이 만나는 지점에서 강연·워크숍·컨설팅 문의를 받습니다. 교회·기업·교육기관 상황에 맞게, 두려움도 맹신도 없이 분별 있는 내용으로 준비합니다.</p>

        <ul class="tags" aria-label="문의 유형 예시">
          {inquiryTypes.map((t) => <li>{t}</li>)}
        </ul>

        <dl class="direct">
          <div class="direct-row">
            <dt>Email</dt>
            <dd><a href={`mailto:${email}`}>{email}</a></dd>
          </div>
          <div class="direct-row">
            <dt>Phone</dt>
            <dd><a href={`tel:${phone.replace(/-/g, '')}`}>{phone}</a></dd>
          </div>
        </dl>
      </div>

      <form
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="form"
        novalidate
      >
        {/* access_key는 PUBLIC_WEB3FORMS_ACCESS_KEY 환경변수에서 주입(시크릿 미커밋). */}
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="[kylechoi.com] 강연·교육 문의" />
        {/* AJAX(fetch) 제출이므로 Web3Forms redirect input은 사용하지 않고 JSON 콜백으로 처리(WARN-1). */}
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="field">
          <label for="name">이름 <span class="req">*</span></label>
          <input
            id="name"
            type="text"
            name="name"
            placeholder="이름 또는 소속 담당자명"
            required
            autocomplete="name"
          />
        </div>

        <div class="field">
          <label for="org">소속</label>
          <input
            id="org"
            type="text"
            name="organization"
            placeholder="교회 · 기업 · 기관명 (선택)"
            autocomplete="organization"
          />
        </div>

        <div class="field">
          <label for="email">이메일 <span class="req">*</span></label>
          <input
            id="email"
            type="email"
            name="email"
            placeholder="답변받을 이메일 주소"
            required
            autocomplete="email"
          />
        </div>

        <div class="field">
          <label for="inquiry-type">문의 유형</label>
          <select id="inquiry-type" name="inquiry_type">
            {inquiryTypes.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>

        <div class="field">
          <label for="message">내용 <span class="req">*</span></label>
          <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="일정·장소·대상·예산 등 아는 범위에서 적어주시면 답변이 빨라집니다."
            required
          ></textarea>
        </div>

        <button type="submit" class="btn-submit">메일로 문의하기</button>

        <p id="form-result" class="form-result" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .contact-section { padding-block: var(--space-section); }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(2rem, 1.2rem + 3vw, 4.5rem);
    align-items: start;
  }
  @media (max-width: 780px) { .contact-grid { grid-template-columns: 1fr; } }

  .contact-info h1 { margin-top: 0.25em; }
  .lede { color: var(--muted); line-height: 1.7; margin-top: 1.1rem; max-width: 42ch; }

  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 0.55rem; padding: 0; margin: 1.8rem 0 0; }
  .tags li {
    font-size: 0.85rem; font-weight: 600; color: var(--accent-ink);
    padding: 0.4rem 0.85rem; border: 1px solid var(--line); border-radius: 999px; background: var(--surface);
  }

  .direct { margin: 2rem 0 0; padding-top: 1.6rem; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 0.7rem; }
  .direct-row { display: flex; align-items: baseline; gap: 0.75rem; }
  .direct dt { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--faint); width: 4.5rem; flex-shrink: 0; }
  .direct dd { margin: 0; font-size: 1.05rem; font-weight: 600; }
  .direct a { color: var(--ink); text-decoration: none; }
  .direct a:hover { color: var(--accent-ink); text-decoration: underline; }

  .form { display: flex; flex-direction: column; gap: 1.4rem; }

  .field { display: flex; flex-direction: column; gap: 0.45rem; }
  .field label { font-size: 0.9rem; font-weight: 600; color: var(--ink); letter-spacing: 0.01em; }
  .req { color: var(--accent-ink); }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-size: 1rem;
    font-family: inherit;
    line-height: 1.5;
    transition: border-color var(--dur) var(--ease);
  }
  .field select { appearance: auto; cursor: pointer; }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .field textarea { resize: vertical; min-height: 140px; }

  .btn-submit {
    align-self: flex-start;
    padding: 0.75rem 2rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity var(--dur) var(--ease);
  }
  .btn-submit:hover { opacity: 0.88; }
  .btn-submit:disabled { opacity: 0.5; cursor: default; }

  .form-result { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.6; }
  .form-result.success { color: #1a7a40; }
  .form-result.error { color: #c0392b; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const result = document.getElementById('form-result') as HTMLParagraphElement | null;
  const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !result || !btn) return;

    const data = new FormData(form);
    const name = (data.get('name') as string)?.trim() ?? '';
    const email = (data.get('email') as string)?.trim() ?? '';
    const message = (data.get('message') as string)?.trim() ?? '';
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const showError = (msg: string) => {
      result.textContent = msg;
      result.className = 'form-result error';
      result.hidden = false;
      btn.disabled = false;
      btn.textContent = '메일로 문의하기';
    };

    if (!name || !email || !message) { showError('이름, 이메일, 내용을 모두 입력해 주세요.'); return; }
    if (!emailRe.test(email)) { showError('올바른 이메일 주소를 입력해 주세요.'); return; }

    const accessKey = (data.get('access_key') as string)?.trim() ?? '';
    if (!accessKey) {
      // 폼 백엔드 키 미설정 — 사용자에겐 대체 연락 안내, 콘솔엔 원인 기록(WARN-3).
      console.error('[contact] PUBLIC_WEB3FORMS_ACCESS_KEY 미설정 — 폼 제출 불가.');
      showError('현재 문의 폼을 준비 중입니다. greatson79@gmail.com 또는 010-3094-8899 로 직접 연락해 주세요.');
      return;
    }

    btn.disabled = true;
    btn.textContent = '전송 중...';
    result.hidden = true;
    result.className = 'form-result';

    try {
      const res = await fetch(form.action, { method: 'POST', body: data });
      const json = await res.json().catch(() => ({}));

      if (res.ok && json.success) {
        result.textContent = '문의가 접수되었습니다. 확인 후 답변 드리겠습니다.';
        result.className = 'form-result success';
        form.reset();
        setTimeout(() => { btn.disabled = false; btn.textContent = '메일로 문의하기'; }, 3000);
      } else {
        // 실제 원인(HTTP 상태·Web3Forms 메시지)은 콘솔에 남기고, 사용자에겐 일반 문구 유지(WARN-3).
        throw new Error(`Web3Forms 응답 실패 (HTTP ${res.status}): ${json.message || '알 수 없는 오류'}`);
      }
    } catch (err) {
      console.error('[contact] 제출 오류:', err);
      result.textContent = '전송 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.';
      result.className = 'form-result error';
      btn.disabled = false;
      btn.textContent = '메일로 문의하기';
    } finally {
      result.hidden = false;
    }
  });
</script>
