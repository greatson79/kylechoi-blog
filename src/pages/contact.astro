---
// /contact — 문의 페이지
// 폼 백엔드: Web3Forms (access_key = 환경변수 주입, 시크릿 미커밋)
// 제출 도착지 이메일은 Web3Forms 대시보드에서 access_key 발급 시 지정한다(폼 코드에 넣지 않음).
// ★프로비저닝(주인님 계정 액션): web3forms.com에서 greatson79@gmail.com으로 access_key 발급 →
//   .env(로컬)·Vercel 환경변수에 PUBLIC_WEB3FORMS_ACCESS_KEY=<발급키> 설정. 미설정 시 폼은 안내 문구 표시.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
---
<BaseLayout title="문의 — Kyle Choi Notes" description="Kyle Choi Notes에 문의하려면 이 폼을 이용해 주세요. 글·강의·컨설팅에 대한 질문을 환영합니다.">
  <Header slot="header" />

  <section class="contact-section section">
    <div class="container narrow">
      <p class="eyebrow">Contact</p>
      <h1>연락하기</h1>
      <p class="lede">글에 관한 질문, 강의·컨설팅 문의, 그 외 무엇이든 환영합니다. 아래 폼으로 보내주시면 확인 후 답변 드리겠습니다.</p>

      <form
        id="contact-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        class="form"
        novalidate
      >
        {/* access_key는 PUBLIC_WEB3FORMS_ACCESS_KEY 환경변수에서 주입(시크릿 미커밋). */}
        <input type="hidden" name="access_key" value={accessKey} />
        <input type="hidden" name="subject" value="[kylechoi.com] 새 문의" />
        {/* AJAX(fetch) 제출이므로 Web3Forms redirect input은 사용하지 않고 JSON 콜백으로 처리(WARN-1). */}
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="field">
          <label for="name">이름</label>
          <input
            id="name"
            type="text"
            name="name"
            placeholder="이름 또는 닉네임"
            required
            autocomplete="name"
          />
        </div>

        <div class="field">
          <label for="email">이메일</label>
          <input
            id="email"
            type="email"
            name="email"
            placeholder="답변받을 이메일 주소"
            required
            autocomplete="email"
          />
        </div>

        <div class="field">
          <label for="message">메시지</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            placeholder="문의 내용을 적어주세요."
            required
          ></textarea>
        </div>

        <button type="submit" class="btn-submit">보내기</button>

        <p id="form-result" class="form-result" aria-live="polite" hidden></p>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .contact-section { padding-block: var(--space-section); }
  .narrow { max-width: 56ch; }
  .contact-section h1 { margin-top: 0.2em; }
  .lede { color: var(--muted); line-height: 1.7; margin-bottom: 2.2rem; max-width: 52ch; }

  .form { display: flex; flex-direction: column; gap: 1.4rem; }

  .field { display: flex; flex-direction: column; gap: 0.45rem; }
  .field label { font-size: 0.9rem; font-weight: 600; color: var(--ink); letter-spacing: 0.01em; }

  .field input,
  .field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font-size: 1rem;
    font-family: inherit;
    line-height: 1.5;
    transition: border-color var(--dur) var(--ease);
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--accent);
  }
  .field textarea { resize: vertical; min-height: 140px; }

  .btn-submit {
    align-self: flex-start;
    padding: 0.75rem 2rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: var(--radius);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity var(--dur) var(--ease);
  }
  .btn-submit:hover { opacity: 0.88; }
  .btn-submit:disabled { opacity: 0.5; cursor: default; }

  .form-result { margin-top: 0.5rem; font-size: 0.95rem; line-height: 1.6; }
  .form-result.success { color: #1a7a40; }
  .form-result.error { color: #c0392b; }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const result = document.getElementById('form-result') as HTMLParagraphElement | null;
  const btn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || !result || !btn) return;

    const data = new FormData(form);
    const name = (data.get('name') as string)?.trim() ?? '';
    const email = (data.get('email') as string)?.trim() ?? '';
    const message = (data.get('message') as string)?.trim() ?? '';
    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    const showError = (msg: string) => {
      result.textContent = msg;
      result.className = 'form-result error';
      result.hidden = false;
      btn.disabled = false;
      btn.textContent = '보내기';
    };

    if (!name || !email || !message) { showError('이름, 이메일, 메시지를 모두 입력해 주세요.'); return; }
    if (!emailRe.test(email)) { showError('올바른 이메일 주소를 입력해 주세요.'); return; }

    const accessKey = (data.get('access_key') as string)?.trim() ?? '';
    if (!accessKey) {
      // 폼 백엔드 키 미설정 — 사용자에겐 대체 연락 안내, 콘솔엔 원인 기록(WARN-3).
      console.error('[contact] PUBLIC_WEB3FORMS_ACCESS_KEY 미설정 — 폼 제출 불가.');
      showError('현재 문의 폼을 준비 중입니다. greatson79@gmail.com 으로 직접 보내주세요.');
      return;
    }

    btn.disabled = true;
    btn.textContent = '전송 중...';
    result.hidden = true;
    result.className = 'form-result';

    try {
      const res = await fetch(form.action, { method: 'POST', body: data });
      const json = await res.json().catch(() => ({}));

      if (res.ok && json.success) {
        result.textContent = '문의가 접수되었습니다. 확인 후 답변 드리겠습니다.';
        result.className = 'form-result success';
        form.reset();
        setTimeout(() => { btn.disabled = false; btn.textContent = '보내기'; }, 3000);
      } else {
        // 실제 원인(HTTP 상태·Web3Forms 메시지)은 콘솔에 남기고, 사용자에겐 일반 문구 유지(WARN-3).
        throw new Error(`Web3Forms 응답 실패 (HTTP ${res.status}): ${json.message || '알 수 없는 오류'}`);
      }
    } catch (err) {
      console.error('[contact] 제출 오류:', err);
      result.textContent = '전송 중 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.';
      result.className = 'form-result error';
      btn.disabled = false;
      btn.textContent = '보내기';
    } finally {
      result.hidden = false;
    }
  });
</script>
