---
// Ministry 목록 — 설교·묵상 통합 목회 아티클(★주인님 지시: ministry 단일).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/nav/Header.astro';
import Footer from '../../components/nav/Footer.astro';
import ArticleCard from '../../components/article/ArticleCard.astro';
import { getCollection } from 'astro:content';

// ★ministry 카테고리(설교·묵상 통합 목회 아티클)
const posts = (await getCollection('ministry', ({ data }) => !data.draft && data.pubDate <= new Date() && data.category === 'ministry'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout title="Ministry — Kyle Choi Notes" description="설교·묵상을 아우르는 목회 아티클." channel="ministry">
  <Header slot="header" />
  <section class="section">
    <div class="container">
      <p class="eyebrow">Ministry</p>
      <h1>Ministry</h1>
      <p class="sub">설교·묵상을 아우르는 목회 아티클.</p>
      {posts.length ? (
        <div class="card-grid" style="margin-top: var(--space-block)">
          {posts.map((p) => (
            <ArticleCard href={`/ministry/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">아직 발행된 글이 없습니다.</p>}
    </div>
  </section>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .sub { color: var(--muted); margin-top: 0.5rem; font-size: var(--text-h3); }
  .empty { color: var(--faint); margin-top: var(--space-block); }
</style>
