---
// 대문 랜딩페이지 — 히어로 + 4분류 소개 + 최신 콘텐츠 + 시대분석(공개·강면책) + 회사/대표 티저. 아임웹 클린.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import { getCollection } from 'astro:content';

// Ministry 섹션 = category='ministry'(설교·묵상 통합). 교육은 /education 별도.
const ministry = (await getCollection('ministry', ({ data }) => !data.draft && data.pubDate <= new Date() && data.category === 'ministry'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// AI트렌드(insight)
const aitrend = (await getCollection('insight', ({ data }) => !data.draft && data.pubDate <= new Date() && data.category === 'AI트렌드' && data.factChecked))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// ★시대분석(insight) — 격리→공개(주인님 2026-06-25 지시). 강면책 상시.
// ★agy HOLD#1 반영: factChecked(사람 검증·승인)된 글만 공개 — 미검증 노출=자가당착·법적리스크 차단.
const eraAnalysis = (await getCollection('insight', ({ data }) => !data.draft && data.pubDate <= new Date() && data.category === '시대분석' && data.factChecked))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// ministry 카테고리 → 트랙 namespace 라우트(상세 URL 분리 유지)
const ministryHref = (cat, id) =>
  cat === '교육' ? `/education/${id}/` : `/ministry/${id}/`;

// ★4분류(주인님 확정): 목회(설교+묵상 병합)·교육·AI트렌드·시대분석
// ★표시 라벨은 네비와 문자 일치시킨다(2026-09-03 라벨 규칙 갱신 — 교육 섹션은 「AI 활용법」).
//   필터값(data.category)·href는 불변.
const categories = [
  { label: 'Ministry', href: '/ministry/', desc: '설교·묵상 등 목회 콘텐츠.' },
  { label: 'AI 활용법', href: '/education/', desc: 'AI 교육 — AI를 분별 있게 배우고 활용하기.' },
  { label: 'AI Trend', href: '/ai-trend/', desc: 'AI의 흐름과 실천적 인사이트.' },
  { label: 'Insight', href: '/insight/', desc: '거시·사회·기술 등 시대 흐름을 정보 제공 목적으로 정리.' },
];

---
<BaseLayout title="Kyle Choi Notes — Faith · AI · Learning" description="두려움도 맹신도 없이, 분별 있게. AI를 일과 삶에 적용하는 법을 직접 만들고, 검증하고, 나눕니다 — 목회·교육·AI트렌드·시대분석.">
  <Header slot="header" />

  <!-- 히어로 — tammura 스타일: 화이트 미니멀·타이포 중심·이미지 없음. 배경 워터마크 직함 + 'Hello / I am Kyle Choi'(블루 그라디언트) + 1인칭 lede + pill CTA. -->
  <section class="hero">
    <span class="hero-watermark" aria-hidden="true">AI EXPERT</span>
    <div class="container hero-inner">
      <p class="hero-hello">Hello</p>
      <h1 class="hero-name">
        <span class="iam">I am</span>
        <span class="name-xl">Kyle Choi</span>
      </h1>
      <p class="hero-lede">두려움도 맹신도 없이, 분별 있게 — 저는 AI를 일과 삶에 적용하는 법을 <strong>직접 만들고, 검증하고, 나눕니다.</strong></p>
      <div class="hero-cta">
        <a class="btn-pill btn-fill" href="#content">콘텐츠 보기 →</a>
        <a class="btn-pill btn-outline" href="/about/">소개 보기 →</a>
      </div>
    </div>
  </section>

  <!-- 4분류 소개 -->
  <section class="section" id="content">
    <div class="container">
      <p class="eyebrow">콘텐츠</p>
      <h2>네 가지 콘텐츠</h2>
      <div class="cat-grid">
        {categories.map((c) => (
          <a class="cat-card" href={c.href}>
            <span class="cat-label">{c.label}</span>
            <span class="cat-desc">{c.desc}</span>
            <span class="cat-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 최신 Ministry (설교·묵상 통합 목회 아티클) -->
  <section class="section section-alt">
    <div class="container">
      <div class="row-head">
        <h2>Ministry</h2>
        <a class="more-link" href="/ministry/">전체 보기 →</a>
      </div>
      {ministry.length ? (
        <div class="card-grid">
          {ministry.slice(0, 6).map((p) => (
            <ArticleCard href={ministryHref(p.data.category, p.id)} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- 최신 AI트렌드 -->
  <section class="section" data-channel="insight">
    <div class="container">
      <div class="row-head">
        <h2>AI Trend</h2>
        <a class="more-link" href="/ai-trend/">전체 보기 →</a>
      </div>
      {aitrend.length ? (
        <div class="card-grid">
          {aitrend.slice(0, 3).map((p) => (
            <ArticleCard href={`/ai-trend/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- ★시대분석 (격리→공개, 주인님 2026-06-25 지시) — 강면책 상시 -->
  <section class="section section-alt" data-channel="insight">
    <div class="container">
      <div class="row-head">
        <h2>Insight</h2>
        <a class="more-link" href="/insight/">전체 보기 →</a>
      </div>
      <aside class="disclaimer" role="note" aria-label="정보 제공 목적 안내">
        <strong>정보 제공 목적 · 투자 자문 아님</strong>
        <p>시대분석은 거시·사회·기술 등 <b>시대 흐름을 정보 제공 목적</b>으로 정리합니다. 특정 종목·상품의
          매매 신호나 투자 자문·권유가 아니며, 자본시장법상 투자자문업·유사투자자문업에 해당하지 않습니다.</p>
      </aside>
      {eraAnalysis.length ? (
        <div class="card-grid">
          {eraAnalysis.slice(0, 3).map((p) => (
            <ArticleCard href={`/insight/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- 회사/대표 티저 -->
  <section class="section about-teaser">
    <div class="container teaser-inner">
      <div class="teaser-text">
        <p class="eyebrow">About · Kyle Choi</p>
        <h2>AI를 일과 삶에<br />적용하는 법을 만듭니다</h2>
        <p class="teaser-lede">여러 AI가 한 조직처럼 협업하고 제가 마지막에 검증·승인합니다. 신학에서 익힌 분별이 기술에 방향을 줍니다.</p>
        <a class="btn btn-ghost" href="/about/">소개 보기 →</a>
      </div>
      <!-- ★헤드샷 = 히어로 콜라주에서 이동(주인님 지시). 본문 아래라 lazy. -->
      <figure class="teaser-photo">
        <picture>
          <source srcset="/founder.webp" type="image/webp" />
          <img src="/founder.jpg" alt="최종학(Kyle Choi) 프로필 사진" width="600" height="860" loading="lazy" decoding="async" />
        </picture>
      </figure>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── 히어로: tammura 스타일 화이트 미니멀·타이포 중심·이미지 없음 ── */
  .hero {
    position: relative; overflow: hidden; isolation: isolate;
    background: var(--bg); text-align: center;
    padding-top: clamp(120px, 9rem + 6vw, 210px);
    padding-bottom: clamp(4rem, 3rem + 6vw, 9rem);
  }
  /* 배경 워터마크 직함 — 초대형 고스트(은은한 배경·aria-hidden·CLS0=절대배치) */
  .hero-watermark {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    z-index: 0; pointer-events: none; user-select: none; white-space: nowrap;
    font-weight: 900; text-transform: uppercase; letter-spacing: -0.03em; line-height: 1;
    font-size: clamp(4rem, 24vw, 23rem); color: var(--ink); opacity: 0.05;
  }
  .hero-inner { position: relative; z-index: 1; }
  .hero-hello {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.4rem); font-weight: 600;
    color: var(--muted); letter-spacing: 0.01em; margin-bottom: clamp(0.5rem, 1.5vw, 1rem);
  }
  .hero-name {
    margin: 0; line-height: 1; display: flex; flex-direction: column; align-items: center;
    gap: clamp(0.2rem, 1vw, 0.6rem);
  }
  .hero-name .iam {
    font-size: clamp(1.5rem, 1rem + 2.2vw, 2.6rem); font-weight: 600;
    color: var(--ink); letter-spacing: -0.01em;
  }
  .hero-name .name-xl {
    font-size: clamp(3.2rem, 1rem + 12vw, 9.5rem); font-weight: 900; letter-spacing: -0.045em;
    background: linear-gradient(100deg, oklch(62% 0.16 255), oklch(72% 0.13 245));
    -webkit-background-clip: text; background-clip: text; color: transparent;
    padding-bottom: 0.06em; /* gradient 텍스트 디센더 클립 방지 */
  }
  .hero-lede {
    margin: clamp(1.6rem, 4vw, 2.6rem) auto 0; max-width: 46ch;
    font-size: var(--text-h3); color: var(--muted); line-height: 1.6;
  }
  .hero-lede strong { color: var(--ink); font-weight: 700; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; justify-content: center; margin-top: clamp(1.8rem, 3vw, 2.4rem); }

  /* pill CTA (라이트 배경 대응) */
  .btn-pill {
    display: inline-block; border-radius: 999px; padding: 0.8rem 1.6rem;
    font-weight: 600; font-size: 0.98rem;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .btn-fill { background: var(--accent); color: #fff; box-shadow: 0 8px 24px oklch(55% 0.10 235 / 0.28); }
  .btn-fill:hover { transform: translateY(-2px); background: oklch(60% 0.12 248); }
  .btn-outline { background: transparent; color: var(--ink); border: 1.5px solid var(--line); }
  .btn-outline:hover { transform: translateY(-2px); border-color: var(--accent); color: var(--accent-ink); }

  @keyframes heroReveal { from { opacity: 0; transform: translateY(0.5em); } to { opacity: 1; transform: none; } }
  .hero-hello, .hero-name, .hero-lede, .hero-cta { animation: heroReveal 0.7s var(--ease) both; }
  .hero-hello { animation-delay: 0.05s; }
  .hero-name { animation-delay: 0.16s; }
  .hero-lede { animation-delay: 0.32s; }
  .hero-cta { animation-delay: 0.44s; }
  @media (prefers-reduced-motion: reduce) {
    .hero-hello, .hero-name, .hero-lede, .hero-cta { animation: none; }
  }

  .btn { display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 600; font-size: 0.95rem; transition: transform var(--dur) var(--ease); }
  .btn:hover { transform: translateY(-2px); }
  .btn-ghost { background: transparent; color: var(--accent-ink); border: 1px solid var(--line); }
  .btn-ghost:hover { border-color: var(--accent); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: var(--gap-grid); margin-top: var(--space-block); }
  .cat-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem 1.5rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease); position: relative; }
  .cat-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .cat-label { font-size: 1.2rem; font-weight: 700; color: var(--ink); }
  .cat-desc { font-size: 0.92rem; color: var(--muted); line-height: 1.55; }
  .cat-arrow { color: var(--accent-ink); font-weight: 700; margin-top: 0.3rem; }

  .section-alt { background: var(--surface); }
  .row-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: var(--space-block); flex-wrap: wrap; }
  .disclaimer { margin: 0 0 var(--space-block); background: var(--bg); border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: var(--radius-sm); padding: 1rem 1.2rem; }
  .disclaimer strong { display: block; font-size: 0.92rem; color: var(--accent-ink); margin-bottom: 0.4rem; }
  .disclaimer p { font-size: 0.84rem; color: var(--muted); line-height: 1.6; margin: 0; }
  .more-link { color: var(--accent-ink); font-weight: 500; font-size: 0.95rem; }
  .empty { color: var(--faint); }

  .about-teaser { background: var(--surface); border-top: 1px solid var(--line); }
  /* ★좌측 정렬 텍스트 + 헤드샷(히어로에서 이동). 텍스트 좌측 거터 유지 */
  .teaser-inner {
    text-align: left; display: grid; grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem); align-items: center;
  }
  .teaser-text { min-width: 0; }
  .teaser-lede { margin-top: 1rem; max-width: 58ch; font-size: var(--text-h3); color: var(--muted); line-height: 1.55; }
  .teaser-photo { margin: 0; width: clamp(160px, 22vw, 220px); }
  .teaser-photo img {
    width: 100%; height: auto; aspect-ratio: 600 / 860; object-fit: cover;
    border-radius: var(--radius); box-shadow: var(--shadow-card); display: block;
  }
  @media (max-width: 640px) {
    .teaser-inner { grid-template-columns: 1fr; gap: clamp(1.5rem, 5vw, 2.2rem); }
    .teaser-photo { width: min(60%, 200px); order: -1; }
  }
  .about-teaser .btn-ghost { margin-top: 1.6rem; }
</style>
