---
// 대문 랜딩페이지 — 히어로 + 4분류 소개 + 최신 콘텐츠 + 시대분석(공개·강면책) + 회사/대표 티저. 아임웹 클린.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import { getCollection } from 'astro:content';

// Ministry 섹션 = category='ministry'(설교·묵상 통합). 교육은 /education 별도.
const ministry = (await getCollection('ministry', ({ data }) => !data.draft && data.category === 'ministry'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// AI트렌드(insight)
const aitrend = (await getCollection('insight', ({ data }) => !data.draft && data.category === 'AI트렌드' && data.factChecked))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// ★시대분석(insight) — 격리→공개(주인님 2026-06-25 지시). 강면책 상시.
// ★agy HOLD#1 반영: factChecked(사람 검증·승인)된 글만 공개 — 미검증 노출=자가당착·법적리스크 차단.
const eraAnalysis = (await getCollection('insight', ({ data }) => !data.draft && data.category === '시대분석' && data.factChecked))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// ministry 카테고리 → 트랙 namespace 라우트(상세 URL 분리 유지)
const ministryHref = (cat, id) =>
  cat === '교육' ? `/education/${id}/` : `/ministry/${id}/`;

// ★4분류(주인님 확정): 목회(설교+묵상 병합)·교육·AI트렌드·시대분석
const categories = [
  { label: 'ministry', href: '/ministry/', desc: '설교·묵상 등 목회 콘텐츠.' },
  { label: '교육', href: '/education/', desc: 'AI 교육 — AI를 분별 있게 배우고 활용하기.' },
  { label: 'AI트렌드', href: '/ai-trend/', desc: 'AI의 흐름과 실천적 인사이트.' },
  { label: '시대분석', href: '/insight/', desc: '거시·사회·기술 등 시대 흐름을 정보 제공 목적으로 정리.' },
];
---
<BaseLayout title="Kyle Choi — AI를 일과 삶에 적용하는 법" description="두려움도 맹신도 없이, 분별 있게. AI를 일과 삶에 적용하는 법을 직접 만들고, 검증하고, 나눕니다 — 목회·교육·AI트렌드·시대분석.">
  <Header slot="header" />

  <!-- 히어로 — 헤드샷 인물중심 split(텍스트 + 헤드샷). 블루는 패널·액센트로 절제. -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">Kyle Choi · 최종학</p>
        <h1 class="hero-title">
          <span class="t-line">AI를</span>
          <span class="t-line">일과 삶에</span>
          <span class="t-line accent">적용하는 법</span>
        </h1>
        <p class="hero-lede">두려움도 맹신도 없이, 분별 있게 — 저는 AI를 일과 삶에 적용하는 법을 <strong>직접 만들고, 검증하고, 나눕니다.</strong></p>
        <div class="hero-cta">
          <a class="btn" href="#content">콘텐츠 보기 →</a>
          <a class="btn btn-ghost" href="/about/">소개 보기 →</a>
        </div>
      </div>
      <figure class="hero-photo">
        <span class="photo-panel" aria-hidden="true"></span>
        <picture>
          <source srcset="/founder.webp" type="image/webp" />
          <img src="/founder.jpg" alt="최종학(Kyle Choi) 프로필 사진" width="600" height="860" loading="eager" fetchpriority="high" decoding="async" />
        </picture>
      </figure>
    </div>
  </section>

  <!-- 4분류 소개 -->
  <section class="section" id="content">
    <div class="container">
      <p class="eyebrow">콘텐츠</p>
      <h2>네 가지 콘텐츠</h2>
      <div class="cat-grid">
        {categories.map((c) => (
          <a class="cat-card" href={c.href}>
            <span class="cat-label">{c.label}</span>
            <span class="cat-desc">{c.desc}</span>
            <span class="cat-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 최신 Ministry (설교·묵상 통합 목회 아티클) -->
  <section class="section section-alt">
    <div class="container">
      <div class="row-head">
        <h2>Ministry</h2>
        <a class="more-link" href="/ministry/">전체 보기 →</a>
      </div>
      {ministry.length ? (
        <div class="card-grid">
          {ministry.slice(0, 6).map((p) => (
            <ArticleCard href={ministryHref(p.data.category, p.id)} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- 최신 AI트렌드 -->
  <section class="section" data-channel="insight">
    <div class="container">
      <div class="row-head">
        <h2>AI트렌드</h2>
        <a class="more-link" href="/ai-trend/">전체 보기 →</a>
      </div>
      {aitrend.length ? (
        <div class="card-grid">
          {aitrend.slice(0, 3).map((p) => (
            <ArticleCard href={`/ai-trend/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- ★시대분석 (격리→공개, 주인님 2026-06-25 지시) — 강면책 상시 -->
  <section class="section section-alt" data-channel="insight">
    <div class="container">
      <div class="row-head">
        <h2>시대분석</h2>
        <a class="more-link" href="/insight/">전체 보기 →</a>
      </div>
      <aside class="disclaimer" role="note" aria-label="정보 제공 목적 안내">
        <strong>정보 제공 목적 · 투자 자문 아님</strong>
        <p>시대분석은 거시·사회·기술 등 <b>시대 흐름을 정보 제공 목적</b>으로 정리합니다. 특정 종목·상품의
          매매 신호나 투자 자문·권유가 아니며, 자본시장법상 투자자문업·유사투자자문업에 해당하지 않습니다.</p>
      </aside>
      {eraAnalysis.length ? (
        <div class="card-grid">
          {eraAnalysis.slice(0, 3).map((p) => (
            <ArticleCard href={`/insight/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- 회사/대표 티저 -->
  <section class="section about-teaser">
    <div class="container teaser-inner">
      <p class="eyebrow">About · Kyle Choi</p>
      <h2>AI를 일과 삶에<br />적용하는 법을 만듭니다</h2>
      <p class="teaser-lede">여러 AI가 한 조직처럼 협업하고 제가 마지막에 검증·승인합니다. 신학에서 익힌 분별이 기술에 방향을 줍니다.</p>
      <a class="btn btn-ghost" href="/about/">소개 보기 →</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── 히어로: 헤드샷 인물중심 split(텍스트 + 사진). 블루는 패널·액센트로 절제 ── */
  .hero {
    position: relative; overflow: hidden;
    padding-block: clamp(2.5rem, 2rem + 5vw, 5.5rem);
    background: var(--bg);
  }
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 1rem + 4vw, 4.5rem); align-items: center;
  }
  .hero-copy { min-width: 0; }
  .hero-kicker {
    font-size: clamp(0.82rem, 0.74rem + 0.3vw, 0.98rem); font-weight: 700;
    letter-spacing: 0.14em; color: var(--accent-ink); text-transform: uppercase;
    margin-bottom: clamp(0.9rem, 2vw, 1.4rem);
  }
  .hero-title {
    margin: 0; font-weight: 800; line-height: 1.04; letter-spacing: -0.035em;
    display: flex; flex-direction: column;
  }
  .hero-title .t-line { font-size: var(--text-hero); color: var(--ink); display: block; }
  .hero-title .t-line.accent { color: var(--accent-ink); }
  .hero-lede {
    margin-top: clamp(1.3rem, 3vw, 2rem); max-width: 42ch;
    font-size: var(--text-h3); color: var(--muted); line-height: 1.6;
  }
  .hero-lede strong { color: var(--ink); font-weight: 700; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: clamp(1.6rem, 3vw, 2.2rem); }

  /* 헤드샷 — 블루 액센트 패널을 뒤로 오프셋해 깊이(layering) */
  .hero-photo { position: relative; margin: 0; justify-self: end; width: min(100%, 400px); }
  .hero-photo .photo-panel {
    position: absolute; inset: 0; transform: translate(18px, 18px);
    background: linear-gradient(158deg, var(--hero-bg), var(--hero-bg-2));
    border-radius: var(--radius); z-index: 0;
  }
  .hero-photo picture { position: relative; z-index: 1; display: block; }
  .hero-photo img {
    width: 100%; height: auto; aspect-ratio: 600 / 860; object-fit: cover;
    border-radius: var(--radius); box-shadow: var(--shadow-card); display: block;
  }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; gap: clamp(2rem, 6vw, 3rem); }
    .hero-photo { order: -1; justify-self: start; width: min(72%, 320px); }
  }

  @keyframes heroReveal { from { opacity: 0; transform: translateY(0.35em); } to { opacity: 1; transform: none; } }
  .hero-kicker, .hero-title .t-line, .hero-lede, .hero-cta, .hero-photo { animation: heroReveal 0.7s var(--ease) both; }
  .hero-kicker { animation-delay: 0.04s; }
  .hero-title .t-line:nth-child(1) { animation-delay: 0.12s; }
  .hero-title .t-line:nth-child(2) { animation-delay: 0.2s; }
  .hero-title .t-line:nth-child(3) { animation-delay: 0.28s; }
  .hero-lede { animation-delay: 0.38s; }
  .hero-cta { animation-delay: 0.46s; }
  .hero-photo { animation-delay: 0.16s; }
  @media (prefers-reduced-motion: reduce) {
    .hero-kicker, .hero-title .t-line, .hero-lede, .hero-cta, .hero-photo { animation: none; }
  }

  .btn { display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 600; font-size: 0.95rem; transition: transform var(--dur) var(--ease); }
  .btn:hover { transform: translateY(-2px); }
  .btn-ghost { background: transparent; color: var(--accent-ink); border: 1px solid var(--line); }
  .btn-ghost:hover { border-color: var(--accent); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: var(--gap-grid); margin-top: var(--space-block); }
  .cat-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem 1.5rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease); position: relative; }
  .cat-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .cat-label { font-size: 1.2rem; font-weight: 700; color: var(--ink); }
  .cat-desc { font-size: 0.92rem; color: var(--muted); line-height: 1.55; }
  .cat-arrow { color: var(--accent-ink); font-weight: 700; margin-top: 0.3rem; }

  .section-alt { background: var(--surface); }
  .row-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: var(--space-block); flex-wrap: wrap; }
  .disclaimer { margin: 0 0 var(--space-block); background: var(--bg); border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: var(--radius-sm); padding: 1rem 1.2rem; }
  .disclaimer strong { display: block; font-size: 0.92rem; color: var(--accent-ink); margin-bottom: 0.4rem; }
  .disclaimer p { font-size: 0.84rem; color: var(--muted); line-height: 1.6; margin: 0; }
  .more-link { color: var(--accent-ink); font-weight: 500; font-size: 0.95rem; }
  .empty { color: var(--faint); }

  .about-teaser { background: var(--surface); border-top: 1px solid var(--line); }
  .teaser-inner { max-width: 60ch; }
  .teaser-lede { margin-top: 1rem; font-size: var(--text-h3); color: var(--muted); line-height: 1.55; }
  .about-teaser .btn-ghost { margin-top: 1.6rem; }
</style>
