---
// 대문 랜딩페이지 — 히어로 + 4분류 소개 + 최신 콘텐츠 + 시대분석(공개·강면책) + 회사/대표 티저. 아임웹 클린.
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';
import ArticleCard from '../components/article/ArticleCard.astro';
import { getCollection } from 'astro:content';

// Ministry 섹션 = category='ministry'(설교·묵상 통합). 교육은 /education 별도.
const ministry = (await getCollection('ministry', ({ data }) => !data.draft && data.category === 'ministry'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// AI트렌드(insight)
const aitrend = (await getCollection('insight', ({ data }) => !data.draft && data.category === 'AI트렌드' && data.factChecked))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
// ★시대분석(insight) — 격리→공개(주인님 2026-06-25 지시). 강면책 상시.
// ★agy HOLD#1 반영: factChecked(사람 검증·승인)된 글만 공개 — 미검증 노출=자가당착·법적리스크 차단.
const eraAnalysis = (await getCollection('insight', ({ data }) => !data.draft && data.category === '시대분석' && data.factChecked))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// ministry 카테고리 → 트랙 namespace 라우트(상세 URL 분리 유지)
const ministryHref = (cat, id) =>
  cat === '교육' ? `/education/${id}/` : `/ministry/${id}/`;

// ★4분류(주인님 확정): 목회(설교+묵상 병합)·교육·AI트렌드·시대분석
// ★표시 라벨만 영문(네비 일치). 필터값(data.category)·href는 불변.
const categories = [
  { label: 'Ministry', href: '/ministry/', desc: '설교·묵상 등 목회 콘텐츠.' },
  { label: 'Education', href: '/education/', desc: 'AI 교육 — AI를 분별 있게 배우고 활용하기.' },
  { label: 'AI Trend', href: '/ai-trend/', desc: 'AI의 흐름과 실천적 인사이트.' },
  { label: 'Insight', href: '/insight/', desc: '거시·사회·기술 등 시대 흐름을 정보 제공 목적으로 정리.' },
];

// ★히어로 콜라주 카드 — 실제 최신 글 2장(텍스트 카드, 신규 이미지 0) + 헤드샷 카드(마크업).
const pickCard = (arr, badge, hrefFn) =>
  arr[0] ? { badge, title: arr[0].data.title, href: hrefFn(arr[0]) } : null;
const collage = [
  pickCard(aitrend, 'AI트렌드', (p) => `/ai-trend/${p.id}/`),
  pickCard(ministry, 'Ministry', (p) => ministryHref(p.data.category, p.id)),
  pickCard(eraAnalysis, '시대분석', (p) => `/insight/${p.id}/`),
].filter(Boolean).slice(0, 2);
---
<BaseLayout title="Kyle Choi — AI를 일과 삶에 적용하는 법" description="두려움도 맹신도 없이, 분별 있게. AI를 일과 삶에 적용하는 법을 직접 만들고, 검증하고, 나눕니다 — 목회·교육·AI트렌드·시대분석.">
  <Header slot="header" variant="hero" />

  <!-- 히어로 — 다크 에디토리얼 캔버스 + 초대형 타이포 + 콘텐츠 카드 콜라주(헤드샷 편입). 참조 스타일 차용·블루 액센트 보존·1인칭. -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-kicker">Kyle Choi · 최종학</p>
        <h1 class="hero-title">
          <span class="t-line">AI를</span>
          <span class="t-line">일과 삶에</span>
          <span class="t-line accent">적용하는 법</span>
        </h1>
        <p class="hero-lede">두려움도 맹신도 없이, 분별 있게 — 저는 AI를 일과 삶에 적용하는 법을 <strong>직접 만들고, 검증하고, 나눕니다.</strong></p>
        <div class="hero-cta">
          <a class="btn-pill btn-fill" href="#content">콘텐츠 보기 →</a>
          <a class="btn-pill btn-outline" href="/about/">소개 보기 →</a>
        </div>
      </div>

      <div class="hero-collage">
        <figure class="ccard ccard-photo">
          <picture>
            <source srcset="/founder.webp" type="image/webp" />
            <img src="/founder.jpg" alt="최종학(Kyle Choi) 프로필 사진" width="600" height="860" loading="eager" fetchpriority="high" decoding="async" />
          </picture>
          <figcaption>Kyle Choi</figcaption>
        </figure>
        {collage.map((c, i) => (
          <a class:list={['ccard', 'ccard-article', `pos-${i}`]} href={c.href}>
            <span class="cc-badge">{c.badge}</span>
            <span class="cc-title">{c.title}</span>
            <span class="cc-go" aria-hidden="true">읽기 →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4분류 소개 -->
  <section class="section" id="content">
    <div class="container">
      <p class="eyebrow">콘텐츠</p>
      <h2>네 가지 콘텐츠</h2>
      <div class="cat-grid">
        {categories.map((c) => (
          <a class="cat-card" href={c.href}>
            <span class="cat-label">{c.label}</span>
            <span class="cat-desc">{c.desc}</span>
            <span class="cat-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 최신 Ministry (설교·묵상 통합 목회 아티클) -->
  <section class="section section-alt">
    <div class="container">
      <div class="row-head">
        <h2>Ministry</h2>
        <a class="more-link" href="/ministry/">전체 보기 →</a>
      </div>
      {ministry.length ? (
        <div class="card-grid">
          {ministry.slice(0, 6).map((p) => (
            <ArticleCard href={ministryHref(p.data.category, p.id)} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- 최신 AI트렌드 -->
  <section class="section" data-channel="insight">
    <div class="container">
      <div class="row-head">
        <h2>AI Trend</h2>
        <a class="more-link" href="/ai-trend/">전체 보기 →</a>
      </div>
      {aitrend.length ? (
        <div class="card-grid">
          {aitrend.slice(0, 3).map((p) => (
            <ArticleCard href={`/ai-trend/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- ★시대분석 (격리→공개, 주인님 2026-06-25 지시) — 강면책 상시 -->
  <section class="section section-alt" data-channel="insight">
    <div class="container">
      <div class="row-head">
        <h2>Insight</h2>
        <a class="more-link" href="/insight/">전체 보기 →</a>
      </div>
      <aside class="disclaimer" role="note" aria-label="정보 제공 목적 안내">
        <strong>정보 제공 목적 · 투자 자문 아님</strong>
        <p>시대분석은 거시·사회·기술 등 <b>시대 흐름을 정보 제공 목적</b>으로 정리합니다. 특정 종목·상품의
          매매 신호나 투자 자문·권유가 아니며, 자본시장법상 투자자문업·유사투자자문업에 해당하지 않습니다.</p>
      </aside>
      {eraAnalysis.length ? (
        <div class="card-grid">
          {eraAnalysis.slice(0, 3).map((p) => (
            <ArticleCard href={`/insight/${p.id}/`} title={p.data.title} description={p.data.description}
              category={p.data.category} pubDate={p.data.pubDate} heroImage={p.data.heroImage} />
          ))}
        </div>
      ) : <p class="empty">콘텐츠 준비 중입니다.</p>}
    </div>
  </section>

  <!-- 회사/대표 티저 -->
  <section class="section about-teaser">
    <div class="container teaser-inner">
      <p class="eyebrow">About · Kyle Choi</p>
      <h2>AI를 일과 삶에<br />적용하는 법을 만듭니다</h2>
      <p class="teaser-lede">여러 AI가 한 조직처럼 협업하고 제가 마지막에 검증·승인합니다. 신학에서 익힌 분별이 기술에 방향을 줍니다.</p>
      <a class="btn btn-ghost" href="/about/">소개 보기 →</a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  /* ── 히어로: 다크 에디토리얼 캔버스 + 초대형 타이포 + 콘텐츠 카드 콜라주 ── */
  .hero {
    position: relative; overflow: hidden; color: #fff;
    padding-top: clamp(96px, 7rem + 4vw, 150px);
    padding-bottom: clamp(3rem, 2rem + 5vw, 6rem);
    background:
      radial-gradient(115% 85% at 88% 8%, oklch(34% 0.09 262 / 0.65), transparent 58%),
      linear-gradient(168deg, var(--foot-bg), oklch(15% 0.03 264));
  }
  .hero-inner {
    display: grid; grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem); align-items: center;
  }
  .hero-copy { min-width: 0; }
  .hero-kicker {
    font-size: clamp(0.82rem, 0.74rem + 0.3vw, 1rem); font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase;
    color: oklch(80% 0.09 252); margin-bottom: clamp(0.9rem, 2vw, 1.4rem);
  }
  .hero-title {
    margin: 0; font-weight: 900; line-height: 0.98; letter-spacing: -0.04em;
    display: flex; flex-direction: column;
  }
  .hero-title .t-line { font-size: clamp(2.7rem, 1rem + 8vw, 6rem); color: #fff; display: block; }
  .hero-title .t-line.accent { color: oklch(74% 0.14 252); }
  .hero-lede {
    margin-top: clamp(1.3rem, 3vw, 2rem); max-width: 42ch;
    font-size: var(--text-h3); color: rgba(255,255,255,0.82); line-height: 1.6;
  }
  .hero-lede strong { color: #fff; font-weight: 700; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: clamp(1.6rem, 3vw, 2.2rem); }

  /* pill CTA */
  .btn-pill {
    display: inline-block; border-radius: 999px; padding: 0.8rem 1.6rem;
    font-weight: 600; font-size: 0.98rem;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .btn-fill { background: oklch(62% 0.16 255); color: #fff; box-shadow: 0 8px 24px oklch(55% 0.16 255 / 0.4); }
  .btn-fill:hover { transform: translateY(-2px); background: oklch(67% 0.16 255); }
  .btn-outline { background: transparent; color: #fff; border: 1.5px solid rgba(255,255,255,0.42); }
  .btn-outline:hover { transform: translateY(-2px); border-color: #fff; background: rgba(255,255,255,0.08); }

  /* 콜라주 — 카드 회전·겹침(grid-stack). 헤드샷 + 실제 글카드. CLS 방어=aspect-ratio·width/height */
  .hero-collage {
    position: relative; display: grid; place-items: center;
    justify-self: end; width: 100%;
    min-height: clamp(340px, 38vw, 470px);
  }
  .hero-collage > * { grid-area: 1 / 1; }
  .ccard {
    border-radius: var(--radius); box-shadow: 0 20px 50px rgba(0,0,0,0.45);
    transform: translate(var(--x, 0), var(--y, 0)) rotate(var(--r, 0deg));
  }
  .ccard-photo { --x: -30%; --y: 7%; --r: -5deg; z-index: 3; width: clamp(168px, 20vw, 230px); background: #fff; padding: 10px 10px 8px; }
  .ccard-photo picture { display: block; }
  .ccard-photo img {
    width: 100%; height: auto; aspect-ratio: 600 / 860; object-fit: cover;
    border-radius: calc(var(--radius) - 6px); display: block;
  }
  .ccard-photo figcaption { margin-top: 0.5rem; text-align: center; font-size: 0.8rem; font-weight: 700; color: var(--ink); letter-spacing: 0.02em; }
  .ccard-article {
    width: clamp(188px, 21vw, 250px); aspect-ratio: 5 / 6;
    background: #fff; color: var(--ink); padding: 1.1rem 1.2rem 1rem;
    display: flex; flex-direction: column; gap: 0.5rem; text-align: left;
    transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .ccard-article.pos-0 { --x: 30%; --y: -14%; --r: 4deg; z-index: 2; }
  .ccard-article.pos-1 { --x: -4%; --y: 27%; --r: -9deg; z-index: 1; }
  .ccard-article:hover { transform: translate(var(--x, 0), var(--y, 0)) rotate(var(--r, 0deg)) scale(1.04); box-shadow: 0 26px 64px rgba(0,0,0,0.55); z-index: 5; }
  .cc-badge { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent-ink); }
  .cc-title { font-size: 1.02rem; font-weight: 700; line-height: 1.35; color: var(--ink); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .cc-go { margin-top: auto; font-size: 0.82rem; font-weight: 600; color: var(--accent-ink); }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; gap: clamp(2.5rem, 8vw, 3.5rem); }
    .hero-collage { justify-self: center; min-height: clamp(320px, 66vw, 420px); }
    .ccard-photo { --x: -28%; }
    .ccard-article.pos-0 { --x: 27%; } .ccard-article.pos-1 { --x: -2%; }
  }
  @media (max-width: 480px) {
    .ccard-photo { width: clamp(148px, 42vw, 188px); --x: -24%; --y: 5%; }
    .ccard-article { width: clamp(158px, 46vw, 208px); }
    .ccard-article.pos-0 { --x: 22%; --y: -11%; } .ccard-article.pos-1 { --x: 0%; --y: 22%; }
  }

  @keyframes heroReveal { from { opacity: 0; transform: translateY(0.4em); } to { opacity: 1; transform: none; } }
  .hero-kicker, .hero-title .t-line, .hero-lede, .hero-cta, .hero-collage { animation: heroReveal 0.7s var(--ease) both; }
  .hero-kicker { animation-delay: 0.04s; }
  .hero-title .t-line:nth-child(1) { animation-delay: 0.12s; }
  .hero-title .t-line:nth-child(2) { animation-delay: 0.2s; }
  .hero-title .t-line:nth-child(3) { animation-delay: 0.28s; }
  .hero-lede { animation-delay: 0.38s; }
  .hero-cta { animation-delay: 0.46s; }
  .hero-collage { animation-delay: 0.2s; animation-duration: 0.85s; }
  @media (prefers-reduced-motion: reduce) {
    .hero-kicker, .hero-title .t-line, .hero-lede, .hero-cta, .hero-collage { animation: none; }
  }

  .btn { display: inline-block; padding: 0.7rem 1.4rem; border-radius: 999px; background: var(--accent); color: #fff; font-weight: 600; font-size: 0.95rem; transition: transform var(--dur) var(--ease); }
  .btn:hover { transform: translateY(-2px); }
  .btn-ghost { background: transparent; color: var(--accent-ink); border: 1px solid var(--line); }
  .btn-ghost:hover { border-color: var(--accent); }

  .cat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: var(--gap-grid); margin-top: var(--space-block); }
  .cat-card { display: flex; flex-direction: column; gap: 0.5rem; padding: 1.4rem 1.5rem; background: var(--bg); border: 1px solid var(--line); border-radius: var(--radius); transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease); position: relative; }
  .cat-card:hover { transform: translateY(-4px); border-color: var(--accent); }
  .cat-label { font-size: 1.2rem; font-weight: 700; color: var(--ink); }
  .cat-desc { font-size: 0.92rem; color: var(--muted); line-height: 1.55; }
  .cat-arrow { color: var(--accent-ink); font-weight: 700; margin-top: 0.3rem; }

  .section-alt { background: var(--surface); }
  .row-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: var(--space-block); flex-wrap: wrap; }
  .disclaimer { margin: 0 0 var(--space-block); background: var(--bg); border: 1px solid var(--line);
    border-left: 3px solid var(--accent); border-radius: var(--radius-sm); padding: 1rem 1.2rem; }
  .disclaimer strong { display: block; font-size: 0.92rem; color: var(--accent-ink); margin-bottom: 0.4rem; }
  .disclaimer p { font-size: 0.84rem; color: var(--muted); line-height: 1.6; margin: 0; }
  .more-link { color: var(--accent-ink); font-weight: 500; font-size: 0.95rem; }
  .empty { color: var(--faint); }

  .about-teaser { background: var(--surface); border-top: 1px solid var(--line); }
  /* ★좌측 정렬: 표준 컨테이너(다른 섹션과 동일 좌측 거터) + lede만 가독폭 캡(가운데정렬 원인=60ch 컨테이너 margin auto 제거) */
  .teaser-inner { text-align: left; }
  .teaser-lede { margin-top: 1rem; max-width: 58ch; font-size: var(--text-h3); color: var(--muted); line-height: 1.55; }
  .about-teaser .btn-ghost { margin-top: 1.6rem; }
</style>
