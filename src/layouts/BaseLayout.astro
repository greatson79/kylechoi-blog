---
// 모든 페이지의 기반 레이아웃 — head 메타(SEO/OG) + 글로벌 스타일 + Pretendard
import '../styles/global.css';
// Pretendard 변수 폰트(동적 서브셋, 자체 호스팅 — 성능). 경로는 pretendard 패키지 기준.
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';

interface Props {
  title: string;
  description?: string;
  channel?: 'ministry' | 'insight';
  ogImage?: string;
}
const {
  title,
  description = 'Kyle Choi Notes — Faith · AI · Learning · 신앙·AI·배움에 관한 기록',
  channel,
  ogImage,
} = Astro.props;
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).toString();
// og:image — 페이지가 ogImage(아티클 히어로 등)를 주면 그것을, 없으면 기본 OG 타이틀 카드.
// 소셜 스크레이퍼는 절대 URL을 요구하므로 site 기준으로 해소한다(상대경로 폴백 방지).
const DEFAULT_OG = '/og-cover.png';
const ogImageUrl = new URL(ogImage ?? DEFAULT_OG, site).toString();
---
<!doctype html>
<html lang="ko" data-channel={channel}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- ★완전공개(production): 검색 색인 허용 — 2026-06-26 주인님 승인. -->
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />
  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Kyle Choi Notes" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="generator" content={Astro.generator} />
  <!-- Google AdSense -->
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4454801451324451" crossorigin="anonymous"></script>
</head>
<body>
  <slot name="header" />
  <main id="main">
    <slot />
  </main>
  <slot name="footer" />
</body>
</html>
