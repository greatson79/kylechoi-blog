---
// 아티클 레이아웃(목회·교육) — 읽기 최적화 본문(.prose, 68ch).
import BaseLayout from './BaseLayout.astro';
import Header from '../components/nav/Header.astro';
import Footer from '../components/nav/Footer.astro';

interface Props {
  title: string;
  description?: string;
  category?: string;
  pubDate?: Date;
  author?: string;
  heroImage?: { src: string; alt: string };
  channel?: 'ministry' | 'insight';
}
const { title, description, category, pubDate, author = '디딤', heroImage, channel = 'ministry' } = Astro.props;
const dateStr = pubDate
  ? new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }).format(pubDate)
  : '';
---
<BaseLayout title={`${title} — Kyle Choi Notes`} description={description} channel={channel} ogImage={heroImage?.src}>
  <Header slot="header" />
  <article class="article">
    <header class="article-head container">
      <div class="head-inner">
        {category && <span class="eyebrow">{category}</span>}
        <h1>{title}</h1>
        <p class="meta">{author}{dateStr && <span> · {dateStr}</span>}</p>
      </div>
    </header>
    {heroImage && (
      <div class="article-hero container">
        <img src={heroImage.src} alt={heroImage.alt} width="1200" height="630" fetchpriority="high" />
      </div>
    )}
    <div class="container">
      <slot name="before-body" />
      <div class="prose"><slot /></div>
    </div>
  </article>
  <Footer slot="footer" />
</BaseLayout>

<style>
  .article-head { padding-top: var(--space-block); }
  .head-inner { max-width: var(--measure); margin-inline: auto; }
  .head-inner h1 { margin-top: 0.3em; }
  .meta { color: var(--muted); font-size: 0.9rem; margin-top: 0.6rem; }
  .article-hero { margin-block: var(--space-block); }
  .article-hero img { display: block; width: 100%; max-width: var(--measure); margin-inline: auto; height: auto; border-radius: var(--radius); aspect-ratio: 1200/630; object-fit: cover; }
</style>
